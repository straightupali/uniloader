{
  "manifest_version": 3,
  "name": "Uniloader button",
  "short_name": "Video DL",
  "version": "2.0",
  "description": "One-click button that sends the page or a link to the Uniloader desktop app.",
  "permissions": ["contextMenus", "activeTab"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Download this video",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
